        <mxCell id="n2" value="Employee Sarah moves from&#10;Sales -&gt; Engineering" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="Does Sarah have a current&#10;row in Dim_Employee?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="140" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="No (first time)&#10;INSERT new row&#10;start_date=today, end_date=NULL,&#10;is_current=1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="Yes&#10;UPDATE existing row&#10;SET end_date=today, is_current=0&#10;(close old version)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="280" width="260" height="90" as="geometry" />
