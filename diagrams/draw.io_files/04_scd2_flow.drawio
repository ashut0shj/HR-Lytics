        <mxCell id="n6" value="INSERT new row&#10;department_name=Engineering&#10;start_date=today, end_date=NULL,&#10;is_current=1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="420" width="260" height="90" as="geometry" />
